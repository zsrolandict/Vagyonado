# A fejlesztői indító külön 3001-es API-t és 5173-as Vite szervert indít.
# Éles build kiszolgálásakor a node server.mjs az alábbi portot használja.
PORT=3000
# Privát, tartós kötetre mutasson; soha ne a public vagy dist mappába.
LEADS_DB_PATH=.local/leads.sqlite
# A kapcsolatfelvétel jelenleg bemutató módú, e-mail/CRM-értesítés nélkül.
